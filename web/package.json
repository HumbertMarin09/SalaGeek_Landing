{
  "name": "salageek-v3",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "prebuild": "tsx scripts/prepare-content.ts",
    "build": "npm run assets:legacy && npm run render:htaccess && astro build && tsx scripts/stamp-htaccess.ts",
    "preview": "astro preview",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:api": "vitest run tests/api",
    "test:e2e": "playwright test",
    "verify": "npm run typecheck && npm run test && npm run build",
    "capture": "tsx scripts/capture.ts",
    "smoke": "tsx scripts/smoke.ts",
    "db:guard": "tsx scripts/check-migrations.ts",
    "sync:legacy": "tsx scripts/sync-legacy.ts",
    "content:export": "tsx scripts/export-content.ts",
    "assets:legacy": "tsx scripts/copy-legacy-assets.ts",
    "render:htaccess": "tsx scripts/render-htaccess.ts",
    "db:seed:admin": "tsx scripts/seed-admin.ts",
    "db:ping": "tsx scripts/db-ping.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@astrojs/preact": "^4.1.0",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@prisma/adapter-mariadb": "7.10.0",
    "@prisma/client": "7.10.0",
    "@tiptap/core": "^3.4.2",
    "@tiptap/extension-image": "^3.4.2",
    "@tiptap/extension-link": "^3.4.2",
    "@tiptap/extension-text-align": "^3.4.2",
    "@tiptap/extension-underline": "^3.4.2",
    "@tiptap/extension-youtube": "^3.4.2",
    "@tiptap/starter-kit": "^3.4.2",
    "astro": "^7.3.8",
    "cheerio": "^1.1.2",
    "dotenv": "^17.2.3",
    "iconv-lite": "^0.7.0",
    "preact": "^10.27.2",
    "sanitize-html": "^2.17.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.7.0",
    "@types/sanitize-html": "^2.16.0",
    "prisma": "7.10.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}

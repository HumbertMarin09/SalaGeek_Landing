---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { CANONICAL_ORIGIN, longDate, slotTime } from '../../../lib/content/format';
import { getArticleBySlug, getPublishedArticles, getRelatedArticles, loadSnapshot } from '../../../lib/content/queries';

export function getStaticPaths() {
  return getPublishedArticles().map((article) => ({ params: { slug: article.slug } }));
}

const snapshot = loadSnapshot();
const article = getArticleBySlug(Astro.params.slug ?? '', snapshot);
if (!article) throw new Error('Artículo inexistente');
const related = getRelatedArticles(article, 3, snapshot);
const path = `/blog/articulos/${article.slug}`;
const share = encodeURIComponent(`${CANONICAL_ORIGIN}${path}`);
---

<BaseLayout
  title={`${article.title} | Sala Geek`}
  description={article.metaDescription || article.excerpt}
  path={path}
  image={article.ogImage || article.coverImage || '/src/images/social-card.png'}
  ogType="article"
  noIndex={article.noIndex}
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: article.title,
      datePublished: article.publishedAt,
      dateModified: article.modifiedAt || article.publishedAt,
      author: { '@type': 'Person', name: article.author.name },
      image: article.coverImage ? `${CANONICAL_ORIGIN}${article.coverImage}` : undefined,
      inLanguage: 'es',
      mainEntityOfPage: `${CANONICAL_ORIGIN}${path}`,
    },
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: CANONICAL_ORIGIN },
        { '@type': 'ListItem', position: 2, name: 'Blog', item: `${CANONICAL_ORIGIN}/blog/` },
        { '@type': 'ListItem', position: 3, name: article.category.name, item: `${CANONICAL_ORIGIN}/blog/?categoria=${article.category.id}` },
        { '@type': 'ListItem', position: 4, name: article.title },
      ],
    },
  ]}
>
  <div class="progress" role="progressbar" aria-label="Lectura" aria-valuemin="0" aria-valuemax="100"></div>
  <main class="sheet prose" id="contenido" data-channel={article.category.id}>
    <p class="crumbs">
      <a href="/">Inicio</a>
      <a href="/blog/">Blog</a>
      <a href={`/blog/?categoria=${article.category.id}`}>{article.category.name}</a>
      <span>{article.title}</span>
    </p>
    <p class="on-air">{article.category.name} · {slotTime(article.publishedAt)}</p>
    <h1>{article.title}</h1>
    <p>{article.excerpt}</p>
    <p>Por {article.author.name} · {article.readMinutes} min de lectura · <span data-views={article.slug}>vistas</span></p>
    <p>{longDate(article.publishedAt)}</p>
    {article.coverImage && <img src={article.coverImage} alt="" />}
    <div class="article-content" set:html={article.bodyHtml} />
    <h2>Compartir artículo</h2>
    <div class="share">
      <a href={`https://twitter.com/intent/tweet?url=${share}`}>X</a>
      <a href={`https://www.facebook.com/sharer/sharer.php?u=${share}`}>Facebook</a>
      <a href={`https://wa.me/?text=${share}`}>WhatsApp</a>
      <button type="button" id="copy-link">Copiar enlace</button>
    </div>
    <p>{article.tags.map((tag) => tag.name).join(', ')}</p>
    <h2>También te puede interesar</h2>
    <ul>
      {related.map((item) => <li><a href={`/blog/articulos/${item.slug}`}>{item.title}</a></li>)}
    </ul>
    <h2>Comentarios</h2>
    <div class="giscus-container">
      <script
        src="https://giscus.app/client.js"
        data-repo="HumbertMarin09/SalaGeek_Landing"
        data-repo-id="R_kgDOQN3OMw"
        data-category="Announcements"
        data-category-id="DIC_kwDOQN3OM84C1Dzm"
        data-mapping="pathname"
        data-strict="0"
        data-reactions-enabled="1"
        data-emit-metadata="0"
        data-input-position="top"
        data-theme="light"
        data-lang="es"
        data-loading="lazy"
        crossorigin="anonymous"
        async
      ></script>
    </div>
  </main>
  <script>
    document.querySelector('#copy-link')?.addEventListener('click', async () => {
      await navigator.clipboard.writeText(location.href);
      const button = document.querySelector('#copy-link');
      if (button) button.textContent = '¡Copiado!';
    });
  </script>
</BaseLayout>
